# Copia este archivo a .env y RELLENA cada secreto. Los campos de secreto se dejan
# vacíos a propósito: la aplicación se niega a arrancar con un valor conocido o débil.
#
#   JWT_SECRET        openssl rand -base64 48
#   ADMIN_PASSWORD    openssl rand -base64 24
#   POSTGRES_PASSWORD openssl rand -base64 32
#
# PostgreSQL local (Docker Compose)
POSTGRES_DB=rematoonline
POSTGRES_USER=rematoonline
POSTGRES_PASSWORD=
# Puerto de Postgres en el host. Se publica sólo en 127.0.0.1 (ver docker-compose.yml).
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=4000
# Obligatorio. Mínimo 32 caracteres.
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@rematoonline.cl
# Obligatorio. Mínimo 12 caracteres. Esta cuenta acumula comisiones y penalizaciones.
ADMIN_PASSWORD=
# Opcional. Si se deja vacío, el seed de demostración no crea cuentas.
DEMO_PASSWORD=
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
DATABASE_SSL=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Saltos de proxy de confianza para el límite por IP (nginx = 1).
TRUST_PROXY_HOPS=1

# Frontend (se incorpora al compilar la imagen)
FRONTEND_PORT=4173
VITE_API_URL=http://localhost:4000/api

# Pasarela de pagos Flow. Sin estas claves el abono con tarjeta queda deshabilitado
# (y en producción no se puede abonar saldo de ninguna otra forma).
#   Sandbox:    https://sandbox.flow.cl/api
#   Producción: https://www.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BASE_URL=https://sandbox.flow.cl/api

# Base pública del sitio. Flow debe poder alcanzarla desde internet para enviar la
# confirmación servidor a servidor.
APP_URL=http://localhost:4173
