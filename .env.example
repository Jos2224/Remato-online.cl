# PostgreSQL local (Docker Compose)
POSTGRES_DB=rematoonline
POSTGRES_USER=rematoonline
POSTGRES_PASSWORD=rematoonline_local
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=4000
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@rematoonline.cl
ADMIN_PASSWORD=cambia-esta-clave-admin
DEMO_PASSWORD=demo12345
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
DATABASE_SSL=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Frontend (se incorpora al compilar la imagen)
FRONTEND_PORT=4173
VITE_API_URL=http://localhost:4000/api
